# Copy to .env; keep credentials on the server. Restart server after changes.
FORMA_HOST=127.0.0.1
FORMA_PORT=8770
FORMA_DB=.data/forma.sqlite3
# Optional. Without a key, the real local-template build remains available.
FORMA_MODEL_API_KEY=
# Optional opt-in: reference a named api_key entry in ~/.pi/agent/auth.json.
# FORMA_MODEL_PI_PROVIDER=deepseek
FORMA_MODEL_BASE_URL=https://api.deepseek.com
FORMA_MODEL=deepseek-flash
# responses, chat_completions, anthropic-messages, google-generative-ai, azure-openai-responses
FORMA_MODEL_API=chat_completions
# Set when deploying behind an HTTPS reverse proxy.
FORMA_PUBLIC_URL=
# Only for a local reverse proxy that overwrites X-Real-IP. Default: trust none.
# FORMA_TRUSTED_PROXIES=127.0.0.1/32
# Optional: also allow direct loopback browser access alongside the public proxy.
# Public-host requests still require X-Real-IP; Service Base enables this locally.
# FORMA_ALLOW_LOCAL_ACCESS=1

# Optional: run API only when a separate frontend/nginx serves browser files.
# FORMA_SERVE_FRONTEND=0
# Frontend dev server (environment only, not loaded from this backend .env):
# FORMA_FRONTEND_PORT=5173
# FORMA_API_ORIGIN=http://127.0.0.1:8770
